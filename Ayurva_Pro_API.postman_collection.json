{
    "info": {
        "name": "Luga Vastra E-Commerce API",
        "description": "Complete API collection for Luga Vastra e-commerce backend with 60+ endpoints",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
        "version": "1.0.0"
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{jwt_token}}",
                "type": "string"
            }
        ]
    },
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost:3000/api",
            "type": "string"
        },
        {
            "key": "jwt_token",
            "value": "",
            "type": "string"
        },
        {
            "key": "product_id",
            "value": "",
            "type": "string"
        },
        {
            "key": "order_id",
            "value": "",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "Authentication",
            "item": [
                {
                    "name": "Register User",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 201) {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.collectionVariables.set('jwt_token', jsonData.token);",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/users"
                        }
                    }
                },
                {
                    "name": "Login",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.collectionVariables.set('jwt_token', jsonData.token);",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/users/login"
                        }
                    }
                },
                {
                    "name": "Get Profile",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/users/profile"
                        }
                    }
                }
            ]
        },
        {
            "name": "Products",
            "item": [
                {
                    "name": "Get All Products",
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "GET",
                        "url": {
                            "raw": "{{base_url}}/products?page=1&limit=20",
                            "query": [
                                {
                                    "key": "page",
                                    "value": "1"
                                },
                                {
                                    "key": "limit",
                                    "value": "20"
                                },
                                {
                                    "key": "search",
                                    "value": "",
                                    "disabled": true
                                },
                                {
                                    "key": "category",
                                    "value": "",
                                    "disabled": true
                                },
                                {
                                    "key": "minPrice",
                                    "value": "",
                                    "disabled": true
                                },
                                {
                                    "key": "maxPrice",
                                    "value": "",
                                    "disabled": true
                                },
                                {
                                    "key": "sort",
                                    "value": "-createdAt",
                                    "disabled": true
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Get Product by ID",
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "GET",
                        "url": {
                            "raw": "{{base_url}}/products/{{product_id}}"
                        }
                    }
                },
                {
                    "name": "Search Products",
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "GET",
                        "url": {
                            "raw": "{{base_url}}/products?search=shirt",
                            "query": [
                                {
                                    "key": "search",
                                    "value": "shirt"
                                }
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Cart",
            "item": [
                {
                    "name": "Get Cart",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{base_url}}/cart"
                        }
                    }
                },
                {
                    "name": "Add to Cart",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"productId\": \"{{product_id}}\",\n  \"quantity\": 2\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/cart"
                        }
                    }
                },
                {
                    "name": "Clear Cart",
                    "request": {
                        "method": "DELETE",
                        "url": {
                            "raw": "{{base_url}}/cart/clear"
                        }
                    }
                }
            ]
        },
        {
            "name": "Wishlist",
            "item": [
                {
                    "name": "Get Wishlist",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{base_url}}/wishlist"
                        }
                    }
                },
                {
                    "name": "Add to Wishlist",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"productId\": \"{{product_id}}\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/wishlist"
                        }
                    }
                }
            ]
        },
        {
            "name": "Orders",
            "item": [
                {
                    "name": "Create Order",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"orderItems\": [{\n    \"product\": \"{{product_id}}\",\n    \"name\": \"Test Product\",\n    \"quantity\": 1,\n    \"price\": 599\n  }],\n  \"shippingAddress\": {\n    \"fullName\": \"Test User\",\n    \"phoneNumber\": \"9876543210\",\n    \"address\": \"123 Test St\",\n    \"city\": \"Mumbai\",\n    \"state\": \"Maharashtra\",\n    \"pinCode\": \"400001\"\n  },\n  \"paymentMethod\": \"COD\",\n  \"itemsPrice\": 599,\n  \"shippingPrice\": 50,\n  \"taxPrice\": 60,\n  \"totalPrice\": 709\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/orders"
                        }
                    }
                },
                {
                    "name": "Get My Orders",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{base_url}}/orders/myorders?page=1&limit=10",
                            "query": [
                                {
                                    "key": "page",
                                    "value": "1"
                                },
                                {
                                    "key": "limit",
                                    "value": "10"
                                }
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Reviews",
            "item": [
                {
                    "name": "Create Review",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"rating\": 5,\n  \"comment\": \"Excellent product!\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/products/{{product_id}}/reviews"
                        }
                    }
                },
                {
                    "name": "Get Product Reviews",
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "GET",
                        "url": {
                            "raw": "{{base_url}}/products/{{product_id}}/reviews"
                        }
                    }
                }
            ]
        },
        {
            "name": "Offers & Banners",
            "item": [
                {
                    "name": "Get Active Offers",
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "GET",
                        "url": {
                            "raw": "{{base_url}}/offers"
                        }
                    }
                },
                {
                    "name": "Apply Coupon",
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"code\": \"SUMMER50\",\n  \"orderTotal\": 1000\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/offers/apply"
                        }
                    }
                },
                {
                    "name": "Get Active Banners",
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "GET",
                        "url": {
                            "raw": "{{base_url}}/banners"
                        }
                    }
                }
            ]
        }
    ]
}